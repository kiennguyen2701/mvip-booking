# Supabase — lấy từ Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=your_resend_api_key_here
BOOKING_FROM_EMAIL=Your App <noreply@yourdomain.com>
ADMIN_EMAIL=admin@yourdomain.com
EMAIL_TEST_TO=test@yourdomain.com

# Security — dùng: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Redis / Upstash (optional — fallback về in-memory nếu không set)
UPSTASH_REDIS_REST_URL=your_upstash_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here